rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validReactionMap() {
      return request.resource.data.reactions.keys().hasOnly([
        'useful',
        'interesting',
        'doubtful'
      ]);
    }

    function validRumorVoteMap() {
      return request.resource.data.votes.keys().hasOnly([
        'looks_real',
        'probably_fake',
        'need_more_proof',
        'debunked'
      ]);
    }

    function validCommentTarget() {
      return request.resource.data.targetType in [
        'rumor',
        'trailer',
        'poll',
        'source'
      ];
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'avatarColor',
          'joinedAt',
          'followedTopics',
          'badges',
          'updatedAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.followedTopics is list
        && request.resource.data.badges is list;
      allow update: if owns(userId)
        && changedOnly([
          'username',
          'usernameLower',
          'avatarColor',
          'followedTopics',
          'badges',
          'updatedAt'
        ])
        && request.resource.data.followedTopics is list
        && request.resource.data.badges is list;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.tags is list
        && validReactionMap();
      allow update: if signedIn()
        && changedOnly(['reactions'])
        && validReactionMap();
      allow delete: if isAdmin();
    }

    match /rumors/{rumorId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.summary is string
        && request.resource.data.topic is string
        && validRumorVoteMap();
      allow update: if signedIn()
        && changedOnly(['votes'])
        && validRumorVoteMap();
      allow delete: if isAdmin();
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.question is string
        && request.resource.data.options is list
        && request.resource.data.votes is map;
      allow update: if signedIn()
        && changedOnly(['votes'])
        && request.resource.data.votes is map;
      allow delete: if isAdmin();
    }

    match /sources/{sourceId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.url is string
        && request.resource.data.claim is string
        && request.resource.data.category is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'review';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.targetId is string
        && validCommentTarget();
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.body is string
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.toId in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update, delete: if false;
    }
  }
}
