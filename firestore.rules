rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validReactionMap() {
      return request.resource.data.reactions.keys().hasOnly([
        'useful',
        'interesting',
        'doubtful'
      ]);
    }

    function validPostAttachment(attachment) {
      return attachment is map
        && attachment.keys().hasOnly([
          'name',
          'size',
          'type',
          'provider',
          'fileId',
          'fileUniqueId',
          'messageId',
          'kind',
          'storageStatus'
        ])
        && attachment.keys().hasAll([
          'name',
          'size',
          'type',
          'provider',
          'fileId',
          'kind',
          'storageStatus'
        ])
        && attachment.name is string
        && attachment.name.size() > 0
        && attachment.name.size() <= 160
        && attachment.size is number
        && attachment.size > 0
        && attachment.size <= 20971520
        && attachment.type is string
        && attachment.type.size() <= 120
        && attachment.type.matches('^(image|video)/[A-Za-z0-9.+_-]+$')
        && attachment.provider == 'telegram_bot'
        && attachment.fileId is string
        && attachment.fileId.size() > 0
        && attachment.fileId.size() <= 512
        && (!('fileUniqueId' in attachment)
          || (attachment.fileUniqueId is string && attachment.fileUniqueId.size() <= 256))
        && (!('messageId' in attachment)
          || (attachment.messageId is string && attachment.messageId.size() <= 64))
        && attachment.kind == 'ugc-post-media'
        && attachment.storageStatus == 'stored';
    }

    function validPostAttachments() {
      return !('attachments' in request.resource.data)
        || (request.resource.data.attachments is list
          && request.resource.data.attachments.size() > 0
          && request.resource.data.attachments.size() <= 4
          && validPostAttachment(request.resource.data.attachments[0])
          && (request.resource.data.attachments.size() < 2
            || validPostAttachment(request.resource.data.attachments[1]))
          && (request.resource.data.attachments.size() < 3
            || validPostAttachment(request.resource.data.attachments[2]))
          && (request.resource.data.attachments.size() < 4
            || validPostAttachment(request.resource.data.attachments[3])));
    }

    function validRumorVoteMap() {
      return request.resource.data.votes.keys().hasOnly([
        'looks_real',
        'probably_fake',
        'need_more_proof',
        'debunked'
      ]);
    }

    function validCommentTarget() {
      return request.resource.data.targetType in [
        'rumor',
        'trailer',
        'poll',
        'source'
      ];
    }

    function validP2PStatus() {
      return request.resource.data.status in [
        'active',
        'sold'
      ];
    }

    function validP2PListingShape() {
      return request.resource.data.keys().hasOnly([
          'sellerId',
          'title',
          'description',
          'category',
          'price',
          'currency',
          'cryptoWalletAddress',
          'deliveryMethod',
          'paymentMethods',
          'properties',
          'previewDataUrl',
          'files',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 90
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.currency is string
        && (!('cryptoWalletAddress' in request.resource.data)
          || (request.resource.data.cryptoWalletAddress is string
            && request.resource.data.cryptoWalletAddress.size() <= 128))
        && request.resource.data.deliveryMethod is string
        && (!('paymentMethods' in request.resource.data)
          || (request.resource.data.paymentMethods is list
            && request.resource.data.paymentMethods.size() > 0
            && request.resource.data.paymentMethods.size() <= 2
            && request.resource.data.paymentMethods.hasOnly(['crypto', 'card'])))
        && request.resource.data.properties is list
        && request.resource.data.properties.size() > 0
        && request.resource.data.properties.size() <= 12
        && request.resource.data.previewDataUrl is string
        && request.resource.data.files is list
        && request.resource.data.files.size() <= 8
        && validP2PStatus();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'avatarColor',
          'bio',
          'photoDataUrl',
          'joinedAt',
          'followedTopics',
          'badges',
          'bookmarkedPostIds',
          'purchasesByTx',
          'updatedAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string
        && request.resource.data.followedTopics is list
        && request.resource.data.badges is list
        && (!('bio' in request.resource.data) || request.resource.data.bio is string)
        && (!('photoDataUrl' in request.resource.data) || request.resource.data.photoDataUrl is string)
        && (!('bookmarkedPostIds' in request.resource.data) || request.resource.data.bookmarkedPostIds is list)
        && (!('purchasesByTx' in request.resource.data) || request.resource.data.purchasesByTx is map);
      allow update: if owns(userId)
        && changedOnly([
          'username',
          'usernameLower',
          'avatarColor',
          'bio',
          'photoDataUrl',
          'followedTopics',
          'badges',
          'bookmarkedPostIds',
          'purchasesByTx',
          'updatedAt'
        ])
        && request.resource.data.followedTopics is list
        && request.resource.data.badges is list
        && (!('bio' in request.resource.data) || request.resource.data.bio is string)
        && (!('photoDataUrl' in request.resource.data) || request.resource.data.photoDataUrl is string)
        && (!('bookmarkedPostIds' in request.resource.data) || request.resource.data.bookmarkedPostIds is list)
        && (!('purchasesByTx' in request.resource.data) || request.resource.data.purchasesByTx is map);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId',
          'body',
          'tags',
          'linkUrl',
          'attachments',
          'createdAt',
          'reactions'
        ])
        && request.resource.data.body is string
        && request.resource.data.tags is list
        && (!('linkUrl' in request.resource.data) || request.resource.data.linkUrl is string)
        && validPostAttachments()
        && validReactionMap();
      allow update: if signedIn()
        && changedOnly(['reactions'])
        && validReactionMap();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /rumors/{rumorId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.summary is string
        && request.resource.data.topic is string
        && validRumorVoteMap();
      allow update: if signedIn()
        && changedOnly(['votes'])
        && validRumorVoteMap();
      allow delete: if isAdmin();
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.question is string
        && request.resource.data.options is list
        && request.resource.data.votes is map;
      allow update: if signedIn()
        && changedOnly(['votes'])
        && request.resource.data.votes is map;
      allow delete: if isAdmin();
    }

    match /sources/{sourceId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.url is string
        && request.resource.data.claim is string
        && request.resource.data.category is string
        && request.resource.data.reason is string
        && request.resource.data.status == 'review';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.targetId is string
        && validCommentTarget();
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.body is string
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.toId in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update, delete: if false;
    }

    match /p2pListings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && validP2PListingShape();
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.createdAt == resource.data.createdAt
        && changedOnly([
          'title',
          'description',
          'category',
          'price',
          'currency',
          'cryptoWalletAddress',
          'deliveryMethod',
          'paymentMethods',
          'properties',
          'previewDataUrl',
          'files',
          'status',
          'updatedAt'
        ])
        && validP2PListingShape();
      allow delete: if signedIn()
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /p2pDeals/{dealId} {
      allow read: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid ||
          isAdmin()
        );
      allow create, update, delete: if false;
    }
  }
}
