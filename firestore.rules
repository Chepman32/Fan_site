rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validHttpsUrl(value) {
      return value is string
        && value.size() <= 2048
        && value.matches('^https?://.+');
    }

    function validPublicUserShape() {
      return request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'avatarColor',
          'bio',
          'photoDataUrl',
          'joinedAt',
          'followedTopics',
          'badges',
          'bookmarkedPostIds',
          'purchasesByTx',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'username',
          'usernameLower',
          'avatarColor',
          'joinedAt',
          'followedTopics',
          'badges'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 60
        && request.resource.data.usernameLower is string
        && request.resource.data.usernameLower.size() >= 3
        && request.resource.data.usernameLower.size() <= 60
        && request.resource.data.avatarColor is string
        && request.resource.data.avatarColor.matches('^#[0-9A-Fa-f]{6}$')
        && (
          request.resource.data.joinedAt is timestamp
          || (request.resource.data.joinedAt is string
            && request.resource.data.joinedAt.size() <= 40)
        )
        && (!('bio' in request.resource.data)
          || (request.resource.data.bio is string && request.resource.data.bio.size() <= 220))
        && (!('photoDataUrl' in request.resource.data)
          || (request.resource.data.photoDataUrl is string
            && request.resource.data.photoDataUrl.size() <= 500000))
        && request.resource.data.followedTopics is list
        && request.resource.data.followedTopics.size() <= 24
        && request.resource.data.badges is list
        && request.resource.data.badges.size() <= 12
        && (!('bookmarkedPostIds' in request.resource.data)
          || (request.resource.data.bookmarkedPostIds is list
            && request.resource.data.bookmarkedPostIds.size() <= 300))
        && (!('purchasesByTx' in request.resource.data)
          || (request.resource.data.purchasesByTx is map
            && request.resource.data.purchasesByTx.keys().size() <= 120));
    }

    function validReactionMap() {
      return request.resource.data.reactions is map
        && request.resource.data.reactions.keys().hasOnly([
          'useful',
          'interesting',
          'doubtful'
        ])
        && (!('useful' in request.resource.data.reactions)
          || (request.resource.data.reactions.useful is list
            && request.resource.data.reactions.useful.size() <= 5000))
        && (!('interesting' in request.resource.data.reactions)
          || (request.resource.data.reactions.interesting is list
            && request.resource.data.reactions.interesting.size() <= 5000))
        && (!('doubtful' in request.resource.data.reactions)
          || (request.resource.data.reactions.doubtful is list
            && request.resource.data.reactions.doubtful.size() <= 5000));
    }

    function validPostShape() {
      return request.resource.data.body is string
        && request.resource.data.body.size() <= 4000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 3
        && (!('linkUrl' in request.resource.data)
          || validHttpsUrl(request.resource.data.linkUrl));
    }

    function validPostAttachment(attachment) {
      return attachment is map
        && attachment.keys().hasOnly([
          'name',
          'size',
          'type',
          'provider',
          'fileId',
          'fileUniqueId',
          'thumbnailFileId',
          'thumbnailFileUniqueId',
          'messageId',
          'kind',
          'storageStatus'
        ])
        && attachment.keys().hasAll([
          'name',
          'size',
          'type',
          'provider',
          'fileId',
          'kind',
          'storageStatus'
        ])
        && attachment.name is string
        && attachment.name.size() > 0
        && attachment.name.size() <= 160
        && attachment.size is number
        && attachment.size > 0
        && attachment.size <= 20971520
        && attachment.type is string
        && attachment.type.size() <= 120
        && attachment.type.matches('^(image|video)/[A-Za-z0-9.+_-]+$')
        && attachment.provider == 'telegram_bot'
        && attachment.fileId is string
        && attachment.fileId.size() > 0
        && attachment.fileId.size() <= 512
        && (!('fileUniqueId' in attachment)
          || (attachment.fileUniqueId is string && attachment.fileUniqueId.size() <= 256))
        && (!('thumbnailFileId' in attachment)
          || (attachment.thumbnailFileId is string && attachment.thumbnailFileId.size() <= 512))
        && (!('thumbnailFileUniqueId' in attachment)
          || (attachment.thumbnailFileUniqueId is string
            && attachment.thumbnailFileUniqueId.size() <= 256))
        && (!('messageId' in attachment)
          || (attachment.messageId is string && attachment.messageId.size() <= 64))
        && attachment.kind == 'ugc-post-media'
        && attachment.storageStatus == 'stored';
    }

    function validPostAttachments() {
      return !('attachments' in request.resource.data)
        || (request.resource.data.attachments is list
          && request.resource.data.attachments.size() > 0
          && request.resource.data.attachments.size() <= 4
          && validPostAttachment(request.resource.data.attachments[0])
          && (request.resource.data.attachments.size() < 2
            || validPostAttachment(request.resource.data.attachments[1]))
          && (request.resource.data.attachments.size() < 3
            || validPostAttachment(request.resource.data.attachments[2]))
          && (request.resource.data.attachments.size() < 4
            || validPostAttachment(request.resource.data.attachments[3])));
    }

    function validRumorVoteMap() {
      return request.resource.data.votes is map
        && request.resource.data.votes.keys().hasOnly([
          'looks_real',
          'probably_fake',
          'need_more_proof',
          'debunked'
        ])
        && request.resource.data.votes.looks_real is list
        && request.resource.data.votes.looks_real.size() <= 5000
        && request.resource.data.votes.probably_fake is list
        && request.resource.data.votes.probably_fake.size() <= 5000
        && request.resource.data.votes.need_more_proof is list
        && request.resource.data.votes.need_more_proof.size() <= 5000
        && request.resource.data.votes.debunked is list
        && request.resource.data.votes.debunked.size() <= 5000;
    }

    function validCommentTarget() {
      return request.resource.data.targetType in [
        'rumor',
        'trailer',
        'poll',
        'source'
      ];
    }

    function validP2PStatus() {
      return request.resource.data.status in [
        'active',
        'sold'
      ];
    }

    function validP2PProperty(property) {
      return property is map
        && property.keys().hasOnly(['key', 'value'])
        && property.key is string
        && property.key.size() > 0
        && property.key.size() <= 30
        && property.value is string
        && property.value.size() > 0
        && property.value.size() <= 64;
    }

    function validP2PProperties() {
      return request.resource.data.properties is list
        && request.resource.data.properties.size() > 0
        && request.resource.data.properties.size() <= 12
        && validP2PProperty(request.resource.data.properties[0])
        && (request.resource.data.properties.size() < 2
          || validP2PProperty(request.resource.data.properties[1]))
        && (request.resource.data.properties.size() < 3
          || validP2PProperty(request.resource.data.properties[2]))
        && (request.resource.data.properties.size() < 4
          || validP2PProperty(request.resource.data.properties[3]))
        && (request.resource.data.properties.size() < 5
          || validP2PProperty(request.resource.data.properties[4]))
        && (request.resource.data.properties.size() < 6
          || validP2PProperty(request.resource.data.properties[5]))
        && (request.resource.data.properties.size() < 7
          || validP2PProperty(request.resource.data.properties[6]))
        && (request.resource.data.properties.size() < 8
          || validP2PProperty(request.resource.data.properties[7]))
        && (request.resource.data.properties.size() < 9
          || validP2PProperty(request.resource.data.properties[8]))
        && (request.resource.data.properties.size() < 10
          || validP2PProperty(request.resource.data.properties[9]))
        && (request.resource.data.properties.size() < 11
          || validP2PProperty(request.resource.data.properties[10]))
        && (request.resource.data.properties.size() < 12
          || validP2PProperty(request.resource.data.properties[11]));
    }

    function validP2PFile(file) {
      return file is map
        && file.keys().hasOnly([
          'name',
          'size',
          'type',
          'provider',
          'fileId',
          'fileUniqueId',
          'messageId',
          'kind',
          'storageStatus'
        ])
        && file.keys().hasAll([
          'name',
          'size',
          'type',
          'provider',
          'fileId',
          'kind',
          'storageStatus'
        ])
        && file.name is string
        && file.name.size() > 0
        && file.name.size() <= 160
        && file.size is number
        && file.size > 0
        && file.size <= 52428800
        && file.type is string
        && file.type.size() <= 120
        && file.provider == 'telegram_bot'
        && file.fileId is string
        && file.fileId.size() > 0
        && file.fileId.size() <= 512
        && (!('fileUniqueId' in file)
          || (file.fileUniqueId is string && file.fileUniqueId.size() <= 256))
        && (!('messageId' in file)
          || (file.messageId is string && file.messageId.size() <= 64))
        && file.kind in ['p2p-listing-file', 'p2p-listing-edit-file']
        && file.storageStatus == 'stored';
    }

    function validP2PFiles() {
      return request.resource.data.files is list
        && request.resource.data.files.size() <= 8
        && (request.resource.data.files.size() < 1
          || validP2PFile(request.resource.data.files[0]))
        && (request.resource.data.files.size() < 2
          || validP2PFile(request.resource.data.files[1]))
        && (request.resource.data.files.size() < 3
          || validP2PFile(request.resource.data.files[2]))
        && (request.resource.data.files.size() < 4
          || validP2PFile(request.resource.data.files[3]))
        && (request.resource.data.files.size() < 5
          || validP2PFile(request.resource.data.files[4]))
        && (request.resource.data.files.size() < 6
          || validP2PFile(request.resource.data.files[5]))
        && (request.resource.data.files.size() < 7
          || validP2PFile(request.resource.data.files[6]))
        && (request.resource.data.files.size() < 8
          || validP2PFile(request.resource.data.files[7]));
    }

    function validP2PListingShape() {
      return request.resource.data.keys().hasOnly([
          'sellerId',
          'title',
          'description',
          'category',
          'price',
          'currency',
          'cryptoWalletAddress',
          'deliveryMethod',
          'paymentMethods',
          'properties',
          'previewDataUrl',
          'files',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 90
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 520
        && request.resource.data.category is string
        && request.resource.data.category in [
          'digital-assets',
          'streaming',
          'guides',
          'services',
          'collectibles',
          'other'
        ]
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000
        && request.resource.data.currency is string
        && request.resource.data.currency == 'USDT'
        && (!('cryptoWalletAddress' in request.resource.data)
          || (request.resource.data.cryptoWalletAddress is string
            && request.resource.data.cryptoWalletAddress.size() <= 128
            && (request.resource.data.cryptoWalletAddress == ''
              || request.resource.data.cryptoWalletAddress.matches('^T[1-9A-HJ-NP-Za-km-z]{33}$'))))
        && request.resource.data.deliveryMethod is string
        && request.resource.data.deliveryMethod.size() <= 80
        && (!('paymentMethods' in request.resource.data)
          || (request.resource.data.paymentMethods is list
            && request.resource.data.paymentMethods.size() > 0
            && request.resource.data.paymentMethods.size() <= 2
            && request.resource.data.paymentMethods.hasOnly(['crypto', 'card'])))
        && validP2PProperties()
        && request.resource.data.previewDataUrl is string
        && request.resource.data.previewDataUrl.size() <= 500000
        && validP2PFiles()
        && validP2PStatus();
    }

    function validUserSettings() {
      return request.resource.data.keys().hasOnly([
          'messagePermission',
          'showActivityStatus',
          'blockedUserIds',
          'mutedUserIds',
          'mutedTopics',
          'hideSpoilers',
          'autoplayVideos',
          'defaultTronPayoutAddress',
          'salePayoutAlerts',
          'confirmWalletBeforeListing',
          'theme',
          'reducedMotion',
          'contentDensity',
          'preferredLanguage',
          'dateTimeFormat',
          'translateVehicleNames',
          'defaultCommunityFeed',
          'updatedAt'
        ])
        && request.resource.data.messagePermission in ['everyone', 'registered', 'nobody']
        && request.resource.data.showActivityStatus is bool
        && request.resource.data.blockedUserIds is list
        && request.resource.data.blockedUserIds.size() <= 200
        && request.resource.data.mutedUserIds is list
        && request.resource.data.mutedUserIds.size() <= 200
        && request.resource.data.mutedTopics is list
        && request.resource.data.mutedTopics.size() <= 50
        && request.resource.data.hideSpoilers is bool
        && request.resource.data.autoplayVideos is bool
        && request.resource.data.defaultTronPayoutAddress is string
        && request.resource.data.defaultTronPayoutAddress.size() <= 128
        && (request.resource.data.defaultTronPayoutAddress == ''
          || request.resource.data.defaultTronPayoutAddress.matches('^T[1-9A-HJ-NP-Za-km-z]{33}$'))
        && request.resource.data.salePayoutAlerts is bool
        && request.resource.data.confirmWalletBeforeListing is bool
        && request.resource.data.theme in ['system', 'dark', 'light']
        && request.resource.data.reducedMotion is bool
        && request.resource.data.contentDensity in ['comfortable', 'compact']
        && request.resource.data.preferredLanguage is string
        && request.resource.data.preferredLanguage in ['', 'en', 'zh', 'ru', 'it', 'id', 'pl', 'hi', 'ms']
        && request.resource.data.dateTimeFormat in ['locale', 'mdy', 'dmy']
        && request.resource.data.translateVehicleNames is bool
        && request.resource.data.defaultCommunityFeed in ['latest', 'trending', 'followed'];
    }

    function validClientErrorLogShape() {
      return request.resource.data.keys().hasOnly([
          'severity',
          'source',
          'name',
          'message',
          'stack',
          'componentStack',
          'details',
          'code',
          'filename',
          'line',
          'column',
          'pagePath',
          'referrerHost',
          'userAgent',
          'language',
          'viewport',
          'online',
          'mode',
          'release',
          'sessionId',
          'fingerprint',
          'userId',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'severity',
          'source',
          'name',
          'message',
          'stack',
          'componentStack',
          'details',
          'code',
          'filename',
          'line',
          'column',
          'pagePath',
          'referrerHost',
          'userAgent',
          'language',
          'viewport',
          'online',
          'mode',
          'release',
          'sessionId',
          'fingerprint',
          'userId',
          'createdAt'
        ])
        && request.resource.data.severity == 'critical'
        && request.resource.data.source in [
          'window.error',
          'unhandledrejection',
          'react-error-boundary',
          'runtime'
        ]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 4000
        && request.resource.data.componentStack is string
        && request.resource.data.componentStack.size() <= 4000
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 120
        && request.resource.data.filename is string
        && request.resource.data.filename.size() <= 500
        && request.resource.data.line is number
        && request.resource.data.line >= 0
        && request.resource.data.line <= 100000
        && request.resource.data.column is number
        && request.resource.data.column >= 0
        && request.resource.data.column <= 100000
        && request.resource.data.pagePath is string
        && request.resource.data.pagePath.size() <= 500
        && request.resource.data.referrerHost is string
        && request.resource.data.referrerHost.size() <= 200
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 300
        && request.resource.data.language is string
        && request.resource.data.language.size() <= 40
        && request.resource.data.viewport is string
        && request.resource.data.viewport.size() <= 40
        && request.resource.data.online is bool
        && request.resource.data.mode is string
        && request.resource.data.mode.size() <= 40
        && request.resource.data.release is string
        && request.resource.data.release.size() <= 80
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.sessionId.size() <= 80
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() > 0
        && request.resource.data.fingerprint.size() <= 120
        && (
          (signedIn() && request.resource.data.userId == request.auth.uid)
          || (!signedIn() && request.resource.data.userId == null)
        )
        && request.resource.data.createdAt == request.time;
    }

    function recipientAllowsMessage(recipientId) {
      let settingsPath = /databases/$(database)/documents/userSettings/$(recipientId);
      return !exists(settingsPath)
        || (
          (!('messagePermission' in get(settingsPath).data)
            || get(settingsPath).data.messagePermission == 'everyone'
            || (get(settingsPath).data.messagePermission == 'registered'
              && request.auth.token.email_verified == true))
          && (!('blockedUserIds' in get(settingsPath).data)
            || !(request.auth.uid in get(settingsPath).data.blockedUserIds))
        );
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if owns(userId)
        && validPublicUserShape();
      allow update: if owns(userId)
        && changedOnly([
          'username',
          'usernameLower',
          'avatarColor',
          'bio',
          'photoDataUrl',
          'followedTopics',
          'badges',
          'bookmarkedPostIds',
          'purchasesByTx',
          'updatedAt'
        ])
        && validPublicUserShape();
      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId) && validUserSettings();
      allow delete: if false;
    }

    match /newsletterSubscriptions/{userId} {
      allow read: if owns(userId);
      allow create, update, delete: if false;
    }

    match /clientErrorLogs/{logId} {
      allow read: if isAdmin();
      allow create: if validClientErrorLogShape();
      allow update, delete: if false;
    }

    match /userActivity/{userId} {
      allow read: if true;
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly(['active', 'lastActiveAt'])
        && request.resource.data.active is bool;
      allow delete: if owns(userId);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId',
          'body',
          'tags',
          'linkUrl',
          'attachments',
          'createdAt',
          'reactions'
        ])
        && validPostShape()
        && validPostAttachments()
        && validReactionMap();
      allow update: if signedIn()
        && changedOnly(['reactions'])
        && validReactionMap();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /rumors/{rumorId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 140
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 700
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 80
        && validRumorVoteMap();
      allow update: if signedIn()
        && changedOnly(['votes'])
        && validRumorVoteMap();
      allow delete: if isAdmin();
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 3
        && request.resource.data.question.size() <= 180
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 8
        && request.resource.data.votes is map;
      allow update: if signedIn()
        && changedOnly(['votes'])
        && request.resource.data.votes is map
        && request.resource.data.votes.keys().size() <= 8;
      allow delete: if isAdmin();
    }

    match /sources/{sourceId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && validHttpsUrl(request.resource.data.url)
        && request.resource.data.claim is string
        && request.resource.data.claim.size() >= 3
        && request.resource.data.claim.size() <= 220
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 700
        && request.resource.data.status == 'review';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 1200
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 160
        && validCommentTarget();
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && recipientAllowsMessage(request.resource.data.toId)
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 2000
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.toId in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn()
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType is string
        && request.resource.data.targetType.size() <= 80
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 160
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 700
        && request.resource.data.status == 'submitted';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /p2pListings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && validP2PListingShape();
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.createdAt == resource.data.createdAt
        && changedOnly([
          'title',
          'description',
          'category',
          'price',
          'currency',
          'cryptoWalletAddress',
          'deliveryMethod',
          'paymentMethods',
          'properties',
          'previewDataUrl',
          'files',
          'status',
          'updatedAt'
        ])
        && validP2PListingShape();
      allow delete: if signedIn()
        && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /p2pDeals/{dealId} {
      allow read: if signedIn()
        && (
          resource.data.buyerId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid ||
          isAdmin()
        );
      allow create, update, delete: if false;
    }
  }
}
